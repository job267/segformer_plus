# Publish only the application source, configuration and presentation README.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/THIRD_PARTY_NOTICES.md
!/requirements.txt
!/pyproject.toml
!/src/
/src/*
!/src/*.py
!/scripts/
/scripts/*
!/scripts/*.py
!/configs/
/configs/*
!/configs/*.yaml
!/demo/
/demo/*
!/demo/app.py
!/demo/index.html
!/docs/
/docs/*
!/docs/licenses/
/docs/licenses/*
!/docs/licenses/SegFormer_LICENSE.txt
!/docs/licenses/CamVid_repository_LICENSE.txt
!/docs/licenses/sources.json

# Never add local credentials, caches or generated artifacts.
**/__pycache__/
**/.env
**/.env.*
*.py[cod]
*.pem
*.key
*.p12
*.pfx
*.pt
*.pth
*.bin
*.safetensors
*.docx
*.pdf
*.zip
*.tmp
